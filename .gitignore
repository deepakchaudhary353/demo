# Ignore Visual Studio temporary files, build results, and
# files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono Auto Generated Files
mono_crash.*

# Windows image file caches
Thumbs.db
Thumbs.db:encryptable
Ehthumbs.db
Ehthumbs.db:encryptable

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Windows shortcuts
*.lnk

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bin/
obj/

# Visual Studio Code workspace settings
.vscode/

# JetBrains Rider
.idea/
*.sln.iml

# Logs
*.log

# npm packages
node_modules/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
env/
venv/
ENV/
VENV/

# C#
*.csproj.user
*.csproj.nuget.g.props
*.csproj.nuget.g.targets
*.dll
*.exe
*.pdb
*.cache
*.ilk
*.log
*.obj
*.suo
*.tlb
*.tlh
*.tmp
*.vspscc
*.vssscc
*.user
*.unsuccessfulbuild
*.vs
*.nupkg
*.snk
*.swp
*.sln.docstates

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows image file caches
Thumbs.db
Thumbs.db:encryptable
Ehthumbs.db
Ehthumbs.db:encryptable

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows shortcuts
*.lnk

# End of https://www.toptal.com/developers/gitignore/api/visualstudio,windows,macos,python,node
